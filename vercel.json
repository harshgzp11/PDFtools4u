{
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    { "source": "/merge-pdf", "destination": "/pdf-merge", "permanent": true },
    { "source": "/split-pdf", "destination": "/pdf-split", "permanent": true },
    { "source": "/pdf-protect", "destination": "/protect-pdf", "permanent": true },
    { "source": "/pdf-unlock", "destination": "/unlock-pdf", "permanent": true },
    { "source": "/pdf-compress", "destination": "/compress-pdf", "permanent": true },
    { "source": "/ocr-pdf", "destination": "/pdf-ocr", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/terms", "destination": "/terms-of-service", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
